# Secrets defined here are available for reference under registry/password, env/secret, builder/secrets,
# and accessories/*/env/secret in config/deploy.yml. All secrets should be pulled from either
# password manager, ENV, or a file. DO NOT ENTER RAW CREDENTIALS HERE! This file needs to be safe for git.

# Bitwarden Secrets Manager adapter
# Replace the UUIDs below with your actual BWS secret IDs
# SECRETS=$(kamal secrets fetch --adapter bitwarden-sm UUID1 UUID2 ...)
# KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD ${SECRETS})
# RAILS_MASTER_KEY=$(kamal secrets extract <%= bws_prefix %>_RAILS_MASTER_KEY ${SECRETS})
# POSTGRES_PASSWORD=$(kamal secrets extract POSTGRES_PASSWORD ${SECRETS})
# HONEYBADGER_API_KEY=$(kamal secrets extract <%= bws_prefix %>_HONEYBADGER_API_KEY ${SECRETS})
# ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=$(kamal secrets extract <%= bws_prefix %>_ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY ${SECRETS})
# ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=$(kamal secrets extract <%= bws_prefix %>_ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT ${SECRETS})
# ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=$(kamal secrets extract <%= bws_prefix %>_ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY ${SECRETS})
# S3_ACCESS_KEY=$(kamal secrets extract <%= bws_prefix %>_S3_ACCESS_KEY ${SECRETS})
# S3_SECRET_KEY=$(kamal secrets extract <%= bws_prefix %>_S3_SECRET_KEY ${SECRETS})
