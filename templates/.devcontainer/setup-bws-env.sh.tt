#!/bin/bash
# Setup BWS environment variables globally in the devcontainer

if [ -n "$BWS_ACCESS_TOKEN" ] && command -v bws >/dev/null 2>&1; then
  echo "Setting up BWS environment variables..."

  BWS_ENV_FILE="/tmp/bws-env-$$.sh"
  touch "$BWS_ENV_FILE"
  chmod 600 "$BWS_ENV_FILE"

  bws run -- sh -c 'env | grep -E "^<%= bws_prefix %>_" | while IFS= read -r line; do
    key="${line%%=*}"
    value="${line#*=}"
    printf "export %s=\"%s\"\n" "$key" "$value"
  done' > "$BWS_ENV_FILE"

  echo '# Map <%= bws_prefix %>_ prefixed variables' >> "$BWS_ENV_FILE"
  echo '[ -n "$<%= bws_prefix %>_RAILS_MASTER_KEY" ] && export RAILS_MASTER_KEY="$<%= bws_prefix %>_RAILS_MASTER_KEY"' >> "$BWS_ENV_FILE"
  echo '[ -n "$<%= bws_prefix %>_HONEYBADGER_API_KEY" ] && export HONEYBADGER_API_KEY="$<%= bws_prefix %>_HONEYBADGER_API_KEY"' >> "$BWS_ENV_FILE"
  echo '[ -n "$<%= bws_prefix %>_ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY" ] && export ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY="$<%= bws_prefix %>_ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY"' >> "$BWS_ENV_FILE"
  echo '[ -n "$<%= bws_prefix %>_ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT" ] && export ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT="$<%= bws_prefix %>_ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT"' >> "$BWS_ENV_FILE"
  echo '[ -n "$<%= bws_prefix %>_ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY" ] && export ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY="$<%= bws_prefix %>_ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY"' >> "$BWS_ENV_FILE"
  echo '[ -n "$<%= bws_prefix %>_S3_ACCESS_KEY" ] && export S3_ACCESS_KEY="$<%= bws_prefix %>_S3_ACCESS_KEY"' >> "$BWS_ENV_FILE"
  echo '[ -n "$<%= bws_prefix %>_S3_SECRET_KEY" ] && export S3_SECRET_KEY="$<%= bws_prefix %>_S3_SECRET_KEY"' >> "$BWS_ENV_FILE"

  cp "$BWS_ENV_FILE" /tmp/bws-env.sh
  chmod 644 /tmp/bws-env.sh
  rm -f "$BWS_ENV_FILE"

  if ! grep -q "bws-env.sh" ~/.bashrc; then
    echo '# Load BWS environment variables' >> ~/.bashrc
    echo '[ -f /tmp/bws-env.sh ] && . /tmp/bws-env.sh' >> ~/.bashrc
  fi

  . /tmp/bws-env.sh

  echo "BWS environment variables configured successfully"
else
  echo "BWS not available or BWS_ACCESS_TOKEN not set - skipping BWS setup"
fi
